# Keep real API credentials in Hostinger environment settings or GitHub Secrets.
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
SAMBANOVA_API_KEY=

# Optional model overrides. OpenRouter models must use the :free suffix.
GROQ_MODEL=
GEMINI_MODEL=
MISTRAL_MODEL=
OPENROUTER_MODEL=
SAMBANOVA_MODEL=

# Explicitly verify the selected model/account is currently free before enabling it.
GROQ_FREE_TIER_CONFIRMED=false
GEMINI_FREE_TIER_CONFIRMED=false
MISTRAL_FREE_TIER_CONFIRMED=false
OPENROUTER_FREE_TIER_CONFIRMED=false
SAMBANOVA_FREE_TIER_CONFIRMED=false
# Optional comma-separated order, e.g. groq,gemini,mistral,openrouter,sambanova
AI_PROVIDER_ORDER=

# Set a unique password and random session token (at least 32 characters).
ADMIN_PASSWORD=
ADMIN_SESSION_TOKEN=

# Send this as an Authorization: Bearer token header to /api/cron/run.
CRON_SECRET=

# SMTP contact delivery (port 465 uses implicit TLS; other ports require STARTTLS).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
CONTACT_EMAIL=

# Production Deployment Site URL
NEXT_PUBLIC_SITE_URL=https://worldbulletin.world

# Search Console: use the exact verified URL-prefix property or sc-domain:worldbulletin.world.
# Store the service-account JSON only in the server environment and grant it access to the property.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
GOOGLE_SEARCH_CONSOLE_SITE_URL=
GSC_SERVICE_ACCOUNT_JSON=

# Comma-separated GA4 measurement IDs; scripts load only after analytics consent.
NEXT_PUBLIC_GA_MEASUREMENT_IDS=G-H9BK8MP506,G-NMM93CJ1ZQ

# Optional absolute path on durable storage outside the deployment directory.
DATABASE_PATH=
